// Esquema de la base de datos. Prisma lee esto para (1) generar un cliente
// TypeScript tipado y (2) crear/versionar las tablas vía migraciones.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Conexión "pooled" (puerto 6543) para las consultas normales de la app.
  url      = env("DATABASE_URL")
  // Conexión DIRECTA (puerto 5432) que Prisma usa para las MIGRACIONES.
  // El pooler transaccional (6543) no sirve para migrar; por eso Supabase
  // te da las dos URLs.
  directUrl = env("DIRECT_URL")
}

// Cada persona registrada. La contraseña se guarda SIEMPRE como hash (nunca en
// texto plano). email único para que no haya cuentas duplicadas.
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  watches      Watch[]
}

// Lo que un usuario elige seguir. Ahora pertenece a un User (userId). Un mismo
// símbolo puede seguirlo cada usuario por su cuenta → @@unique([userId, symbol]).
// onDelete: Cascade = si se borra el usuario, se borran sus watches.
model Watch {
  id        Int      @id @default(autoincrement())
  symbol    String
  name      String
  startedAt DateTime @default(now())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol])
}

// El cierre diario de cada símbolo: la serie temporal que alimenta el gráfico
// y el cálculo del "% desde que empecé". Es GLOBAL por símbolo (no por usuario):
// el cierre de AAPL del 21-sep es el mismo para todos, no se duplica.
// @@unique([symbol, date]) garantiza un solo registro por símbolo y día.
model PricePoint {
  id     Int      @id @default(autoincrement())
  symbol String
  date   DateTime @db.Date
  close  Float

  @@unique([symbol, date])
}
