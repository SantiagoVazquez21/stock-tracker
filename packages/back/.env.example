# Plantilla de variables de entorno del back.
# Copiá este archivo a ".env" (sin ".example") y completá los valores reales.
# El ".env" NUNCA se sube al repo (está en .gitignore); este ".example" SÍ,
# para documentar qué variables hacen falta sin filtrar el secreto.

# API key de Twelve Data (https://twelvedata.com/account/api-keys)
TWELVE_DATA_API_KEY=

# Conexión a Postgres (Supabase → Connect → Prisma).
# DATABASE_URL = pooler (puerto 6543) para las consultas de la app.
# DIRECT_URL   = conexión directa (puerto 5432) para las migraciones.
DATABASE_URL=
DIRECT_URL=
